{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Bash(uv run pytest *)",
      "Bash(uv run labcheck *)",
      "Bash(uv run ruff *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./notes/.cost-ledger.json)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Read(./solutions/**)",
      "Read(./checkpoints/**)",
      "Read(./labcheck/hidden_tests/**)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 .claude/statusline.py",
    "padding": 0
  }
}
