{
  "mcpServers": {
    "git": {
      "command": "uvx",
      "args": ["mcp-server-git", "--repository", "."]
    },
    "taskforge": {
      "command": "uv",
      "args": ["run", "python", "-m", "taskforge.mcp_server"],
      "env": { "TASKFORGE_DB": "${TASKFORGE_DB:-practice-app/taskforge.db}" }
    }
  }
}
